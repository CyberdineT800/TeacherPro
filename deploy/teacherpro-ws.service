[Unit]
Description=TeacherPro WebSocket Worker (Game Engine — 1x)
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/teacherpro/current
EnvironmentFile=-/var/www/teacherpro/.env
Environment="ROOT_PATH="
# Share the runtime directory created by teacherpro-http
RuntimeDirectory=teacherpro
RuntimeDirectoryMode=0755

ExecStart=/var/www/teacherpro/venv/bin/gunicorn \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 1 \
    --bind unix:/run/teacherpro/ws.sock \
    --timeout 3600 \
    --keepalive 3600 \
    --worker-connections 2000 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile - \
    --capture-output \
    --log-level info \
    main:app

Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
