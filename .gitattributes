# Force LF line endings and UTF-8 for all text files
* text=auto eol=lf

*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.service text eol=lf

# Binaries — never touch
*.db    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.xlsx  binary
*.pdf   binary
*.docx  binary
